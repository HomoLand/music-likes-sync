# Optional AI review integration. Leave empty to disable.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local server overrides.
PORT=4319
HOST=127.0.0.1

# Optional runtime directory override. Defaults to the current working directory.
MUSIC_LIKES_SYNC_HOME=

# Optional FFmpeg binary override for local Chromaprint audition alignment.
FFMPEG_PATH=ffmpeg

# Optional UI smoke browser override. Leave empty to auto-detect local Chrome/Edge.
MUSIC_LIKES_SYNC_BROWSER_PATH=

# Optional release gate: make Docker smoke fail instead of skip when Docker is unavailable.
MUSIC_LIKES_SYNC_REQUIRE_DOCKER=0

# Optional OpenTelemetry exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Live provider validation is destructive. Use only with disposable playlists.
MUSIC_LIKES_SYNC_LIVE_VALIDATE=0
MUSIC_LIKES_SYNC_LIVE_CONFIRM=
MUSIC_LIKES_SYNC_LIVE_TARGET=
MUSIC_LIKES_SYNC_LIVE_QUERY=
MUSIC_LIKES_SYNC_LIVE_PLAYLIST_ID=
MUSIC_LIKES_SYNC_LIVE_PLAYLIST_NAME=
QQ_COOKIE_FILE=
NETEASE_COOKIE_FILE=
